from building import *
import rtconfig
import os

src = []
inc = []
group = []

cwd = GetCurrentDir() # get current dir path

port_src = Glob('*.c')
port_inc = [cwd]
group = group + DefineGroup('LVGL-port', port_src, depend = ['PKG_USING_LVGL'], CPPPATH = port_inc)

# check if .h or .hpp files exists
def check_h_hpp_exists(path):
    file_dirs = os.listdir(path)
    for file_dir in file_dirs:
        if os.path.splitext(file_dir)[1] in ['.h', '.hpp']:
            return True
    return False

def is_excluded_path(path, base, exclude_dirs):
    rel = os.path.relpath(path, base).replace('\\', '/')
    for exclude_dir in exclude_dirs:
        if rel == exclude_dir or rel.startswith(exclude_dir + '/'):
            return True
    return False

lvgl_cwd = cwd + '/../../'

lvgl_src_cwd = lvgl_cwd + 'src/'
inc = inc + [lvgl_src_cwd]
src = src + Glob(os.path.join(lvgl_src_cwd,'*.c'))
exclude_dirs = [
    'debugging/monkey',
    'debugging/profiler',
    'debugging/test',
    'debugging/vg_lite_tvg',
    'draw/dma2d',
    'draw/espressif',
    'draw/eve',
    'draw/nanovg',
    'draw/nema_gfx',
    'draw/nxp',
    'draw/opengles',
    'draw/renesas',
    'draw/sdl',
    'draw/snapshot',
    'draw/sw/blend/helium',
    'draw/sw/blend/neon',
    'draw/sw/blend/riscv_v',
    'draw/sw/blend/sve2',
    'draw/vg_lite',
    'drivers',
    'libs/FT800-FT813',
    'libs/barcode',
    'libs/ffmpeg',
    'libs/freetype',
    'libs/frogfs',
    'libs/gif',
    'libs/gltf',
    'libs/gstreamer',
    'libs/libjpeg_turbo',
    'libs/libpng',
    'libs/libwebp',
    'libs/lodepng',
    'libs/lz4',
    'libs/nanovg',
    'libs/qrcode',
    'libs/rle',
    'libs/rlottie',
    'libs/thorvg',
    'libs/tjpgd',
    'libs/vg_lite_driver',
    'stdlib/micropython',
    'stdlib/uefi',
]
for root, dirs, files in os.walk(lvgl_src_cwd):
    dirs[:] = [d for d in dirs if not is_excluded_path(os.path.join(root, d), lvgl_src_cwd, exclude_dirs)]
    for dir in dirs:
        current_path = os.path.join(root, dir)
        src = src + Glob(os.path.join(current_path,'*.c')) # add all .c files
        if check_h_hpp_exists(current_path): # add .h and .hpp path
            inc = inc + [current_path]


if GetDepend('PKG_LVGL_USING_EXAMPLES'):
    lvgl_src_cwd = lvgl_cwd + 'examples/'
    inc = inc + [lvgl_src_cwd]
    for root, dirs, files in os.walk(lvgl_src_cwd):
        for dir in dirs:
            current_path = os.path.join(root, dir)
            src = src + Glob(os.path.join(current_path,'*.c'))
            if check_h_hpp_exists(current_path):
                inc = inc + [current_path]

if GetDepend('PKG_LVGL_USING_DEMOS'):
    lvgl_src_cwd = lvgl_cwd + 'demos/'
    inc = inc + [lvgl_src_cwd]
    src = src + Glob(os.path.join(lvgl_src_cwd,'*.c'))
    demo_dirs = [
        'music',
    ]
    for root, dirs, files in os.walk(lvgl_src_cwd):
        rel = os.path.relpath(root, lvgl_src_cwd).replace('\\', '/')
        if rel == '.':
            dirs[:] = [d for d in dirs if d in demo_dirs]
        for dir in dirs:
            current_path = os.path.join(root, dir)
            src = src + Glob(os.path.join(current_path,'*.c'))
            if check_h_hpp_exists(current_path):
                inc = inc + [current_path]

CFLAGS = ''
if rtconfig.PLATFORM == 'gcc' or rtconfig.PLATFORM == 'armclang': # GCC or Keil AC6
    CFLAGS += ' -std=c99'
elif rtconfig.PLATFORM == 'armcc': # Keil AC5
    CFLAGS += ' --c99 --gnu'

group = group + DefineGroup('LVGL', src, depend = ['PKG_USING_LVGL'], CPPPATH = inc, CFLAGS = CFLAGS)

list = os.listdir(cwd)
for d in list:
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        group = group + SConscript(os.path.join(d, 'SConscript'))

Return('group')
